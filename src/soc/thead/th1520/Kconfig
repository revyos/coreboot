config SOC_THEAD_TH1520
	bool
	select ARCH_RISCV_RV64
	select ARCH_RISCV_S
	select ARCH_RISCV_U
	select ARCH_RISCV_PMP
	select FLATTENED_DEVICE_TREE
	select ARCH_BOOTBLOCK_RISCV
	select ARCH_VERSTAGE_RISCV
	select ARCH_ROMSTAGE_RISCV
	select ARCH_RAMSTAGE_RISCV
	select DRIVERS_UART_8250MEM_32
	select UART_OVERRIDE_REFCLK
	select RISCV_HAS_OPENSBI
	select DRIVERS_RISCV_CLINT
	select BOOT_DEVICE_NOT_SPI_FLASH
	select SPI_FLASH
	select SPI_FLASH_DONT_INCLUDE_ALL_DRIVERS
	select SPI_FLASH_WINBOND
	select SPI_FLASH_GIGADEVICE
	select DRIVERS_SPI_DESIGNWARE
	select COMMONLIB_STORAGE
	select COMMONLIB_STORAGE_MMC
	select SDHCI_CONTROLLER

if SOC_THEAD_TH1520

config SEPARATE_ROMSTAGE
	default n

config MEMLAYOUT_LD_FILE
	default "src/soc/thead/th1520/memlayout.ld"

config RISCV_ARCH
	default "rv64imafdc"

config RISCV_ABI
	default "lp64d"

config RISCV_CODEMODEL
	default "medany"

config MAX_CPUS
	default 4

config RISCV_WORKING_HARTID
	default 0

config RISCV_SOC_HAS_MENVCFG
	default n

config OPENSBI_PLATFORM
	default "generic"

config OPENSBI_TEXT_START
	default 0x80000000

config OPENSBI_FW_DYNAMIC_BOOT_HART
	default -1

config TH1520_CPU_750MHZ
	bool "Initialize the CPU clock to 750 MHz"
	depends on !TH1520_AON
	default y
	help
	  Program the unused CPU PLL and switch with a 150 MHz bus clock.
	  This cold-boot setting leaves voltage control and OS DVFS unchanged.

config TH1520_AON
	bool "Start AON and request the 1.848 GHz CPU operating point"
	help
	  Load a board-configured E902 image, confirm its PMIC mailbox service,
	  request 1.0 V CPU rails and raise CPU frequency only after readback.

config TH1520_AON_FILE
	string "Board-configured AON firmware path"
	depends on TH1520_AON

choice
	prompt "TH1520 boot medium"
	default TH1520_BOOT_AUTO
config TH1520_BOOT_AUTO
	bool "Follow BootROM boot straps"
config TH1520_BOOT_RAM
	bool "RAM download image"
config TH1520_BOOT_SPI
	bool "SPI NOR"
config TH1520_BOOT_EMMC
	bool "eMMC boot0"
endchoice

config TH1520_PAYLOAD_FDT
	bool "Pass a board DTB to the OpenSBI payload"
	depends on RISCV_OPENSBI

config TH1520_PAYLOAD_DTB
	string "Payload DTB path"
	depends on TH1520_PAYLOAD_FDT

config TH1520_STORAGE_TEST
	bool "Read-only storage checks during RAM bring-up"
	default n

endif
